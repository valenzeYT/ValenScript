{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    ["\"", "\""],
    ["[", "]"],
    ["{", "}"]
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(IF|ELSE|WHILE|FOR|REPEAT|FUNC|WHEN)\\b(?!.*\\{\\s*$).*$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
