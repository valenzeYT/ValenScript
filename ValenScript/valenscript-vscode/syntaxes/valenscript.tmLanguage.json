{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ValenScript",
  "scopeName": "source.valenscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#moduleCall" },
    { "include": "#funcCall" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.valenscript",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.valenscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.valenscript",
              "match": "\\\\[nrt\"\\\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.valenscript",
          "match": "\\b\\d(?:[\\d_]*\\d)?(?:\\.\\d(?:[\\d_]*\\d)?)?(?:[eE][+-]?\\d(?:[\\d_]*\\d)?)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.valenscript",
          "match": "\\b(PRINT|WAIT|WHEN|WHILE|IF|ELSE|REPEAT|TIMES|FOR|TO|FUNC|RETURN|BREAK|CONTINUE|IMPORT|AND|OR|NOT|TYPE)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.valenscript",
          "match": "\\b(TRUE|FALSE)\\b"
        }
      ]
    },
    "moduleCall": {
      "patterns": [
        {
          "name": "meta.module-call.valenscript",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.valenscript" },
            "2": { "name": "entity.name.function.valenscript" }
          }
        }
      ]
    },
    "funcCall": {
      "patterns": [
        {
          "name": "entity.name.function.valenscript",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:\\[|\"|\\d|TRUE|FALSE|[A-Za-z_]|\\{|$))"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.valenscript",
          "match": "==|!=|<=|>=|[+\\-*/%=:<>|.,]"
        }
      ]
    }
  }
}
