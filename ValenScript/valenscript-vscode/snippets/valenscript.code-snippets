{
  "Print": {
    "prefix": "print",
    "body": "PRINT ${1:\"text\"}",
    "description": "Print a value"
  },
  "Import": {
    "prefix": "import",
    "body": "IMPORT ${1:os}",
    "description": "Import a module"
  },
  "When Event": {
    "prefix": "when",
    "body": [
      "WHEN ${1:os.write} ${2:path} ${3:content}",
      "\t${4:PRINT [\"event\", path, content]}"
    ],
    "description": "Event handler for module function call"
  },
  "If": {
    "prefix": "if",
    "body": [
      "IF ${1:condition}",
      "\t${2:PRINT \"true\"}"
    ],
    "description": "If block"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "IF ${1:condition}",
      "\t${2:PRINT \"true\"}",
      "ELSE",
      "\t${3:PRINT \"false\"}"
    ],
    "description": "If/Else block"
  },
  "While": {
    "prefix": "while",
    "body": [
      "WHILE ${1:condition}",
      "\t${2:PRINT \"loop\"}"
    ],
    "description": "While loop"
  },
  "For": {
    "prefix": "for",
    "body": [
      "FOR ${1:i} = ${2:0} TO ${3:10}",
      "\t${4:PRINT i}"
    ],
    "description": "For loop"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "FUNC ${1:name} ${2:param}",
      "\t${3:RETURN 0}"
    ],
    "description": "Function definition"
  }
}
