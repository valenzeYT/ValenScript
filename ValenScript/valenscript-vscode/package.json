{
  "name": "valenscript-vscode",
  "displayName": "ValenScript",
  "description": "Syntax highlighting and IntelliSense for ValenScript (.vs)",
  "version": "0.1.0",
  "publisher": "valen",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:valenscript"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "valenscript",
        "aliases": ["ValenScript", "valenscript"],
        "extensions": [".vs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "valenscript",
        "scopeName": "source.valenscript",
        "path": "./syntaxes/valenscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "valenscript",
        "path": "./snippets/valenscript.code-snippets"
      }
    ]
  }
}
