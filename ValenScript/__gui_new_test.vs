IMPORT gui

gui.create_window "Valen UI" 700 500
gui.clear_window
sec : gui.add_section "Header" 20 20 640 110
txt : gui.add_text "Valen GUI Section + Text + Button + Link" 35 50 520 24
btn : gui.add_button "Click me" 35 80 130 28
inp : gui.add_input "Type here" 180 80 220 28
lnk : gui.add_link "Open OpenAI" "https://openai.com" 420 80 150 28
PRINT sec
PRINT txt
PRINT btn
PRINT inp
PRINT lnk
PRINT gui.button_clicked btn
PRINT gui.input_text inp
gui.set_input inp "hello"
PRINT gui.input_text inp
WAIT 0.5
gui.close_window
